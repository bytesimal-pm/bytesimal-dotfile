/* Monochrome widgets for plain Qt apps (hyprland-share-picker, ...), matching
   the Quickshell popups: rounded, thin borders, white = selected.
   Loaded by qt5ct/qt6ct.conf [Interface] stylesheets. */

QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 38);
    border-radius: 10px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #707070;
    padding: 6px 16px;
    margin: 2px;
    border-radius: 8px;
}
QTabBar::tab:hover:!selected {
    background: rgba(255, 255, 255, 20);
    color: #e6e6e6;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #000000;
    font-weight: bold;
}

QPushButton {
    background: rgba(255, 255, 255, 15);
    color: #e6e6e6;
    border: 1px solid rgba(255, 255, 255, 38);
    border-radius: 10px;
    padding: 8px 16px;
}
QPushButton:hover,
QPushButton:focus {
    background: #ffffff;
    color: #000000;
}
QPushButton:pressed {
    background: #d0d0d0;
    color: #000000;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid rgba(255, 255, 255, 90);
    border-radius: 4px;
    background: transparent;
}
QCheckBox::indicator:checked {
    background: #ffffff;
}

QToolTip {
    background: #0a0a0a;
    color: #e6e6e6;
    border: 1px solid rgba(255, 255, 255, 38);
}

// Minimal monochrome fastfetch. Logo: logo.png via the kitty graphics protocol.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/logo.png",
        "width": 33,
        "height": 15,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": "  ",
        "key": {
            "width": 12
        },
        "color": {
            "keys": "white",
            "output": "90",
            "title": "white"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name-colored}\u001b[90m @ {host-name-colored}"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────────"
        },
        {
            "type": "os",
            "key": "󰣇  os",
            "format": "{name}"
        },
        {
            "type": "kernel",
            "key": "  kernel",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "󰅐  uptime"
        },
        {
            "type": "packages",
            "key": "󰏖  pkgs"
        },
        {
            "type": "wm",
            "key": "  wm",
            "format": "{pretty-name}"
        },
        {
            "type": "terminal",
            "key": "  term",
            "format": "{pretty-name}"
        },
        {
            "type": "shell",
            "key": "  shell",
            "format": "{pretty-name}"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────────"
        },
        {
            "type": "cpu",
            "key": "󰻠  cpu",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "󰢮  gpu",
            "hideType": "integrated",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "󰍛  ram",
            "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "key": "󰋊  disk",
            "folders": "/",
            "format": "{size-used} / {size-total}"
        },
        {
            "type": "custom",
            "format": "──────────────────────────────────"
        },
        {
            "type": "custom",
            "format": "\u001b[48;2;0;0;0m    \u001b[48;2;36;36;36m    \u001b[48;2;73;73;73m    \u001b[48;2;109;109;109m    \u001b[48;2;146;146;146m    \u001b[48;2;182;182;182m    \u001b[48;2;219;219;219m    \u001b[48;2;255;255;255m    \u001b[0m"
        }
    ]
}
